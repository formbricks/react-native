{
  "name": "@formbricks/react-native",
  "version": "0.0.0-dev",
  "license": "MIT",
  "description": "Formbricks React Native SDK allows you to connect your app to Formbricks, display surveys and trigger events.",
  "homepage": "https://formbricks.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formbricks/react-native.git"
  },
  "keywords": [
    "Formbricks",
    "surveys",
    "experience management",
    "react native",
    "sdk"
  ],
  "author": "Formbricks <hola@formbricks.com>",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rimraf dist build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && vite build && pnpm run build:dts",
    "build:dev": "rimraf dist build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && vite build --mode dev && pnpm run build:dts",
    "build:dts": "api-extractor run --local && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "lint": "biome check .",
    "dev": "vite build --watch --mode dev",
    "clean": "rimraf .turbo node_modules dist build",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "package-check": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "24.7.2",
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "4.1.12",
    "publint": "0.3.25",
    "react": "19.2.4",
    "react-native": "0.84.1",
    "tsc-alias": "1.8.16",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=2.1.0",
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-webview": ">=13.0.0"
  }
}
